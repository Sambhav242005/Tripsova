# Database
# Production: Postgres + PostGIS (required for geo "near me" search).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tripsova
# Local zero-setup alternative (non-geo endpoints only):
#   DATABASE_URL=sqlite+aiosqlite:///./tripsova_dev.db

# JWT — REQUIRED, no built-in default. Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=30

# Google Places (optional)
GOOGLE_PLACES_API_KEY=

# AI trip generation (optional — when AI_ENABLED is false the rule-based planner is used).
# Works with any OpenAI-compatible chat-completions endpoint: Ollama, OpenRouter, OpenAI, vLLM…
# Defaults below target a local Ollama daemon serving the gemma4:31b-cloud model.
#   - Local Ollama:  AI_API_URL=http://localhost:11434/v1/chat/completions  (no key needed)
#   - OpenRouter:    AI_API_URL=https://openrouter.ai/api/v1/chat/completions  + AI_API_KEY
#   - OpenAI:        AI_API_URL=https://api.openai.com/v1/chat/completions     + AI_API_KEY
AI_ENABLED=false
AI_API_URL=http://localhost:11434/v1/chat/completions
AI_API_KEY=
AI_MODEL=gemma4:31b-cloud
AI_TIMEOUT_SECONDS=120

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,http://localhost:8000,http://127.0.0.1:8000

# App
DEBUG=false
OFFLINE_PACK_MAX_SIZE_MB=50

# Rate limiting (per client IP, per minute)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10

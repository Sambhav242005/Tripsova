# Database
# Production: Postgres + PostGIS (required for geo "near me" search).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tripsova
# Local zero-setup alternative (non-geo endpoints only):
#   DATABASE_URL=sqlite+aiosqlite:///./tripsova_dev.db

# JWT — REQUIRED, no built-in default. Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=30

# Google Places (optional) — fallback food source when OpenStreetMap is thin
# (small towns like Ratlam). The code uses the *Places API (New)*
# (places.googleapis.com/v1); the retired legacy Places API is disabled for new
# Google Cloud projects. In Cloud Console enable "Places API (New)" (not the old
# "Places API"), keep billing on, and if the key is API-restricted, allow it.
GOOGLE_PLACES_API_KEY=

# AI trip generation (optional — when AI_ENABLED is false the rule-based planner is used).
# Works with any OpenAI-compatible chat-completions endpoint: Ollama, OpenRouter, OpenAI, vLLM…
# Defaults below target a local Ollama daemon serving the gemma4:31b-cloud model.
#   - Local Ollama:  AI_API_URL=http://localhost:11434/v1/chat/completions  (no key needed)
#   - OpenRouter:    AI_API_URL=https://openrouter.ai/api/v1/chat/completions  + AI_API_KEY
#   - OpenAI:        AI_API_URL=https://api.openai.com/v1/chat/completions     + AI_API_KEY
AI_ENABLED=false
AI_API_URL=http://localhost:11434/v1/chat/completions
AI_API_KEY=
AI_MODEL=gemma4:31b-cloud
AI_TIMEOUT_SECONDS=120

# Live train lookup (optional). When TRAIN_LIVE_ENABLED is false (or eRail is
# unreachable), train legs fall back to the vendored ~2015 datameet/railways
# snapshot — which can name retired/renumbered trains. Turning this on queries
# eRail's keyless getTrains endpoint for *current* train numbers + times. No key.
TRAIN_LIVE_ENABLED=false
TRAIN_LIVE_API_URL=https://erail.in/rail/getTrains.aspx
TRAIN_LIVE_TIMEOUT_SECONDS=12

# Live flight lookup (optional). No keyless source exists, so a provider token is
# required; without it (or when disabled) flight legs stay distance estimates.
# FLIGHT_PROVIDER picks between two interchangeable backends:
#   travelpayouts — free affiliate token, India-strong, cached/indicative prices
#                   (get a token at https://www.travelpayouts.com/developers/api)
#   amadeus       — real-time 400+ airlines; free key+secret + monthly quota, then paid
#                   (https://developers.amadeus.com ; use AMADEUS_API_BASE=https://api.amadeus.com
#                    for real India data — the test base is thin outside US/EU)
FLIGHT_LIVE_ENABLED=false
FLIGHT_PROVIDER=travelpayouts
FLIGHT_CURRENCY=INR
FLIGHT_LIVE_TIMEOUT_SECONDS=12
TRAVELPAYOUTS_TOKEN=
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_API_BASE=https://test.api.amadeus.com

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,http://localhost:8000,http://127.0.0.1:8000

# App
DEBUG=false
OFFLINE_PACK_MAX_SIZE_MB=50

# Rate limiting (per client IP, per minute)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10

# Geo-lock — restrict to India by default (free IP geolocation via api.country.is)
# GEO_LOCK_ENABLED=true
# GEO_LOCK_ALLOWED_COUNTRIES=IN
# GEO_LOCK_STRICT=false        # true = block when geo lookup fails
